:0,"unit":"ms"}}],"custom_css_group":[{"custom_css":{"code":"","mode":"css"}}],"identifier":[{"0":{}},{"id":"qx-heading-5064"},{"class":""}]}},"slug":"heading","children":[]},{"visibility":{"lg":true,"md":true,"sm":true,"xs":true},"form":{"general":{"tab_fg_element_mode":[[{"title":"Lost Fat"},{"description":"The biggest muscle building mistake people make is training like a bodybuilder And they rarely built the bulk of their muscle size with the routines they do now. That’s why bodybuilding routines don’t work for most people.And much, much more that you can discover when you take your free 7 day trial membership as well as the app included with your membership.<br>&nbsp;Forget about pump and soreness. Instead focus on adding weight on the bar.<br>&nbsp;If you don’t lift more today than last month or year, you’re not building muscle. <br>&nbsp;Do Compounds. Do exercises that work several muscles at the same time. <br>The bulk of your routine should consist of heavy Squats, Bench, Deadlifts, Overhead Presses and Barbell Rows."},{"image":{"url":null,"media":null}},{"img_divider":""},{"alt_text":""},{"caption":""},{"img_width":{"value":1194,"unit":"%"}}],[{"title":"Gain Strength"},{"description":"That’s why bodybuilding routines don’t work for most people. This is what works. The biggest muscle building mistake people make is training like a bodybuilder And they rarely built the bulk of their muscle size.\n\n\t\nDo Compounds. Do exercises that work several muscles at the same time. The bulk of your routine should consist of heavy Squats, Bench, Deadlifts, Overhead Presses and Barbell Rows.\n\t\nAnd much, much more that you can discover when you take your free 7 day trial membership as well as the app included with your membership.\n\t\nForget about pump and soreness. Instead focus on adding weight on the bar. If you don’t lift more today than last month or year, you’re not building muscle."},{"image":{"url":null,"media":null}},{"img_divider":""},{"alt_text":""},{"caption":""},{"img_width":{"value":120,"unit":"px"}}],[{"title":"Build Muscle"},{"description":"You don't have to take my word for it. A number of top bodybuilders from yesterday and Johnnie Jackson, Stan Efferding, and even Arnold their careers as powerlifters. These men first trained for strength before becoming bodybuilders.\n\n\t\nYou’ll get stronger which will increase your overall muscle mass.You’re not building muscle. Forget about pump and soreness. Instead focus on adding weight on the bar.\n\t\nDo Compounds. Do exercises that work several muscles at the same time. The bulk of your routine should consist of heavy Squats, Bench, Deadlifts, Overhead Presses and Barbell Rows.\n\t\nAnd much, much more that you can discover when you take your free 7 day trial membership as well as the app included with your membership."},{"image":{"url":null,"media":null}},{"img_divider":""},{"alt_text":""},{"caption":""},{"img_width":{"value":120,"unit":"px"}}]],"tag_fg_icon":[{"global_icon":{"url":"","media":[]}}],"tab_fg_Aditional":[{"tab_alignment":{"label":"Horizontal","value":"horizontal"}},{"title_html_tag":"h4"}]},"styles":{"tab_fg_style":[{"item_border_width":{"desktop":0,"tablet":1,"phone":1,"responsive_preview":true,"unit":"px","responsive":true}},{"tab_border_color":"rgba(255, 255, 255, 0)"},{"tab_bg_color":"rgba(255, 255, 255, 0)"}],"tab_fg_icon_style":[{"icon_active_color":""},{"icon_spacing":{"desktop":46,"tablet":15,"phone":10,"responsive_preview":true,"unit":"px","responsive":true}}],"tab_fg_title_style":[{"title_alignment":{"label":"Center","icon":"qxuicon-align-center","value":"center"}},{"title_color_divider":""},{"title_color":"rgba(255 ,  255,  255, 1)"},{"title_active_color":"rgba(33 ,  33,  33, 1)"},{"title_bg_color_divider":""},{"title_bg_color":"rgba(255 ,  55,  55, 1)"},{"title_active_bg_color":""},{"tab_title_padding_divider":""},{"title_padding":{"unit":"px","tablet":{"top":10,"bottom":10,"left":15,"right":15},"left":100,"bottom":30,"phone":{"top":10,"bo